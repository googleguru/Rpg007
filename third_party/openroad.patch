@@ -499,3 +499,71 @@ proc fix_max_spacing { args } {
   drt::fix_max_spacing_cmd
 }
 }
+
+# ── RBA-TritonRoute integration commands ───────────────────────────────────
+# See docs/INTEGRATION.md in the RBA-TritonRoute repo for full semantics.
+# Callers should guard these with
+#   if {[llength [info commands set_drt_cost_weights]] > 0} { ... }
+# to remain compatible with a stock (unpatched) OpenROAD build.
+
+sta::define_cmd_args "set_drt_cost_weights" {
+    [-route_shape_cost cost]
+    [-via_cost cost]
+    [-marker_cost cost]
+    [-grid_cost cost]
+}
+proc set_drt_cost_weights { args } {
+  sta::parse_key_args "set_drt_cost_weights" args \
+    keys {-route_shape_cost -via_cost -marker_cost -grid_cost} \
+    flags {}
+  sta::check_argc_eq0 "set_drt_cost_weights" $args
+  if { [info exists keys(-route_shape_cost)] } {
+    set route_shape_cost $keys(-route_shape_cost)
+  } else {
+    set route_shape_cost 8
+  }
+  if { [info exists keys(-via_cost)] } {
+    set via_cost $keys(-via_cost)
+  } else {
+    set via_cost 4
+  }
+  if { [info exists keys(-marker_cost)] } {
+    set marker_cost $keys(-marker_cost)
+  } else {
+    set marker_cost 32
+  }
+  if { [info exists keys(-grid_cost)] } {
+    set grid_cost $keys(-grid_cost)
+  } else {
+    set grid_cost 2
+  }
+  drt::set_drt_cost_weights $route_shape_cost $via_cost $marker_cost $grid_cost
+}
+
+sta::define_cmd_args "set_drt_net_order" {
+    -file filename
+}
+proc set_drt_net_order { args } {
+  sta::parse_key_args "set_drt_net_order" args \
+    keys {-file} \
+    flags {}
+  sta::check_argc_eq0 "set_drt_net_order" $args
+  if { ![info exists keys(-file)] } {
+    utl::error DRT 9003 "-file is required for set_drt_net_order command"
+  }
+  drt::set_drt_net_order $keys(-file)
+}
+
+sta::define_cmd_args "set_drt_ripup_nets" {
+    -file filename
+}
+proc set_drt_ripup_nets { args } {
+  sta::parse_key_args "set_drt_ripup_nets" args \
+    keys {-file} \
+    flags {}
+  sta::check_argc_eq0 "set_drt_ripup_nets" $args
+  if { ![info exists keys(-file)] } {
+    utl::error DRT 9004 "-file is required for set_drt_ripup_nets command"
+  }
+  drt::set_drt_ripup_nets $keys(-file)
+}
