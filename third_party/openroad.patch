+        routes.emplace_back(net, 0, true, nullptr);
+      }
+    }
     mazeIterInit_sortRerouteQueue(0, checks);
     mazeIterInit_sortRerouteQueue(0, routes);
   } else if (getRipupMode() == RipUpMode::ALL) {
