+// RBA-TritonRoute integration commands — see docs/INTEGRATION.md in the
+// RBA-TritonRoute repo (github.com/googleguru/Rpg007) for full semantics.
+
+void set_drt_cost_weights(int route_shape_cost,
+                          int via_cost,
+                          int marker_cost,
+                          int grid_cost)
+{
+  auto* router = ord::OpenRoad::openRoad()->getTritonRoute();
+  auto* cfg = router->getRouterConfiguration();
+  cfg->ROUTESHAPECOST = route_shape_cost;
+  cfg->VIACOST = via_cost;
+  cfg->MARKERCOST = marker_cost;
+  cfg->GRIDCOST = grid_cost;
+}
+
+void set_drt_net_order(const char* file_name)
+{
+  auto* router = ord::OpenRoad::openRoad()->getTritonRoute();
+  auto* cfg = router->getRouterConfiguration();
+  cfg->RBA_NET_PRIORITY.clear();
+  std::ifstream f(file_name);
+  if (!f) {
+    router->getLogger()->error(
+        utl::DRT, 9001, "set_drt_net_order: cannot open {}", file_name);
+    return;
+  }
+  std::string net_name;
+  int rank = 0;
+  while (std::getline(f, net_name)) {
+    if (!net_name.empty()) {
+      cfg->RBA_NET_PRIORITY[net_name] = rank++;
+    }
+  }
+}
+
+void set_drt_ripup_nets(const char* file_name)
+{
+  auto* router = ord::OpenRoad::openRoad()->getTritonRoute();
+  auto* cfg = router->getRouterConfiguration();
+  cfg->RBA_FORCED_RIPUP_NETS.clear();
+  std::ifstream f(file_name);
+  if (!f) {
+    router->getLogger()->error(
+        utl::DRT, 9002, "set_drt_ripup_nets: cannot open {}", file_name);
+    return;
+  }
+  std::string net_name;
+  while (std::getline(f, net_name)) {
+    if (!net_name.empty()) {
+      cfg->RBA_FORCED_RIPUP_NETS.insert(net_name);
+    }
+  }
+}
