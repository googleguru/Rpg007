@@ -11,6 +11,7 @@
 #include <list>
 #include <map>
 #include <memory>
+#include <optional>
 #include <queue>
 #include <random>
 #include <set>
@@ -1623,10 +1624,36 @@ bool FlexDRWorker::mazeIterInit_sortRerouteQueue(
     int mazeIter,
     std::vector<RouteQueueEntry>& rerouteNets)
 {
+  // RBA-TritonRoute: externally-supplied per-net priority (lower = higher
+  // priority), consulted only for entries backed by a drNet whose frNet
+  // name has an entry in RBA_NET_PRIORITY (set via set_drt_net_order).
+  // This is a per-worker-tile ordering hint applied at maze iteration 0,
+  // not a single global sequential net order — see drt-global.h.
+  const auto& rbaPriority = router_cfg_->RBA_NET_PRIORITY;
+  auto rbaRank = [&](frBlockObject* block) -> std::optional<int> {
+    if (rbaPriority.empty() || block->typeId() != drcNet) {
+      return std::nullopt;
+    }
+    auto* dNet = static_cast<drNet*>(block);
+    auto it = rbaPriority.find(dNet->getFrNet()->getName());
+    if (it == rbaPriority.end()) {
+      return std::nullopt;
+    }
+    return it->second;
+  };
   auto rerouteNetsComp
-      = [](RouteQueueEntry const& a, RouteQueueEntry const& b) {
+      = [&](RouteQueueEntry const& a, RouteQueueEntry const& b) {
           auto block1 = a.block;
           auto block2 = b.block;
+          auto rank1 = rbaRank(block1);
+          auto rank2 = rbaRank(block2);
+          if (rank1 || rank2) {
+            int r1 = rank1.value_or(std::numeric_limits<int>::max());
+            int r2 = rank2.value_or(std::numeric_limits<int>::max());
+            if (r1 != r2) {
+              return r1 < r2;
+            }
+          }
           if (block1->typeId() == block2->typeId()) {
             return block1->getId() < block2->getId();
           }
