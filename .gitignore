# Build artifacts
build/
*.o
*.a
*.so
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
dist/
.venv/
venv/

# Streamlit
.streamlit/

# Results (generated — do not track large JSON/PDF)
results/full_results.json
simulation/figures/*.pdf

# Benchmark input files (large; ISPD tarballs have their own redistribution
# terms) — fetch via scripts/setup_ispd_benchmarks.sh or the ISPD contest
# site. benchmarks/manifest.json (checksummed, real counts) IS tracked.
benchmarks/*/
!benchmarks/manifest.json

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Temp
*.tmp
*.log
/tmp/
